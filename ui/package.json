{
  "name": "audiohub-ui",
  "version": "0.1.0",
  "description": "AudioHub 汇聚端图形界面（Electron 壳 + C++ 音频核心）",
  "main": "main.js",
  "license": "Apache-2.0",
  "author": "AudioHub",
  "scripts": {
    "start": "electron .",
    "start:sandbox-off": "electron . --no-sandbox",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.audiohub.hub",
    "productName": "AudioHub",
    "copyright": "Copyright © 2026 AudioHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "scene3d.js",
      "index.html",
      "styles.css",
      "bin/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "icon": "icon.ico",
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "AudioHub-便携版.exe"
    }
  }
}